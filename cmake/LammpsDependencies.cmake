# 只有 LAMMPS 适配层与现有采样层加载宿主头文件及 MPI。
set(LAMMPS_SOURCE_DIR "${LAMMPS_SOURCE_DIR}" CACHE PATH "LAMMPS src directory")
set(LAMMPS_LIB_DIR "${LAMMPS_LIB_DIR}" CACHE PATH "Directory containing liblammps")
foreach(path_name LAMMPS_SOURCE_DIR LAMMPS_LIB_DIR)
    if(NOT ${path_name} AND DEFINED ENV{${path_name}})
        set(${path_name} "$ENV{${path_name}}" CACHE PATH "LAMMPS dependency path" FORCE)
    endif()
endforeach()
if(NOT EXISTS "${LAMMPS_SOURCE_DIR}/lammps.h")
    message(FATAL_ERROR "Set LAMMPS_SOURCE_DIR to the directory containing lammps.h")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/LammpsTrimCompatibility.cmake")
find_library(LAMMPS_LIB NAMES lammps HINTS "${LAMMPS_LIB_DIR}" REQUIRED)
find_package(MPI REQUIRED COMPONENTS CXX)
option(ZQC_LAMMPS_KOKKOS "Borrow CUDA arrays from a matching Kokkos-enabled LAMMPS" OFF)
if(ZQC_LAMMPS_KOKKOS)
    # 必须使用该 liblammps 实际构建的 Kokkos 配置（包含布局/精度/后端 ABI）。
    # 桥接使用原生 CUDA 语言编译，Host 文件继续使用用户指定的 C++ 编译器。
    set(Kokkos_LAUNCH_COMPILER OFF)
    find_package(Kokkos 4.3 CONFIG REQUIRED)
    if(NOT Kokkos_ENABLE_CUDA)
        message(FATAL_ERROR "ZQC_LAMMPS_KOKKOS requires the CUDA Kokkos backend")
    endif()
    if(NOT EXISTS "${LAMMPS_SOURCE_DIR}/KOKKOS/atom_kokkos.h")
        message(FATAL_ERROR "Kokkos adapter requires matching LAMMPS source including src/KOKKOS")
    endif()
endif()
add_library(zqc_lammps_dependencies INTERFACE)
target_include_directories(zqc_lammps_dependencies INTERFACE
    "${LAMMPS_SOURCE_DIR}" "${PROJECT_SOURCE_DIR}/include"
    "${PROJECT_SOURCE_DIR}/include/core" "${PROJECT_SOURCE_DIR}/include/CVsets")
target_link_libraries(zqc_lammps_dependencies INTERFACE MPI::MPI_CXX "${LAMMPS_LIB}")
